# Values for a load test run. Passed with --env-file so that the repository's own .env — which holds real
# MaxMind and SMTP credentials — is never interpolated into a throwaway stack.
#
# Nothing here is a secret. The production file marks these :?required so that a missing setting stops the
# stack instead of breaking a chain silently, which means a local run has to name all of them even where the
# service behind one is never started.

IMAGE_PREFIX=wholestory-local
IMAGE_TAG=latest

# The database roles the init script creates and the services connect as (D-037).
POSTGRES_PASSWORD=loadtest
API_DB_PASSWORD=api
PROCESSOR_DB_PASSWORD=processor

# geoipupdate is not started: the GeoIP database is copied into the volume from infra/geoip instead.
MAXMIND_ACCOUNT_ID=unused
MAXMIND_LICENSE_KEY=unused

# No mail is sent during a load test, and Boot's mail health indicator is off anyway (D-127).
MAIL_HOST=mail.invalid
MAIL_USERNAME=unused
MAIL_PASSWORD=unused
MAIL_FROM=no-reply@wholestory.world

# Grafana is not started for a measurement run; the numbers are read from Prometheus directly.
GRAFANA_ADMIN_PASSWORD=loadtest

# The disposable site the generator posts as. Registered through Site Management during setup, because ingest
# only accepts domains it heard about on site-events (ADR 0019).
LOADTEST_DOMAIN=loadtest.example

RATE=500
DURATION=2m
