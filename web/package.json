{
  "name": "@wholestory/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "api:types": "openapi-typescript openapi.json -o src/lib/api/schema.d.ts",
    "dev": "openapi-typescript openapi.json -o src/lib/api/schema.d.ts && next dev",
    "build": "openapi-typescript openapi.json -o src/lib/api/schema.d.ts && next build",
    "start": "next start",
    "typecheck": "openapi-typescript openapi.json -o src/lib/api/schema.d.ts && next typegen && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
